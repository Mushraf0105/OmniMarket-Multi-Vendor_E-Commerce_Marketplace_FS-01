PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty or set to auto-start in-memory MongoDB)
MONGO_URI=mongodb://localhost:27017/multivendor_ecommerce

# JWT Secret
JWT_SECRET=super_secret_jwt_token_for_assessment_fs01_2026
JWT_EXPIRE=7d

# Redis (Cart & Session Cache)
REDIS_URL=redis://localhost:6379

# Elasticsearch (Search & Filter Engine)
ELASTICSEARCH_NODE=http://localhost:9200

# AWS S3 (Optional - automatically falls back to local disk storage /uploads if not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Razorpay Test Credentials (for split payments)
RAZORPAY_KEY_ID=rzp_test_mockKey12345
RAZORPAY_KEY_SECRET=rzp_secret_mockSecret12345

# Stripe Test Credentials (for Stripe Connect split payments)
STRIPE_SECRET_KEY=sk_test_mockStripeKey12345
STRIPE_PUBLISHABLE_KEY=pk_test_mockStripePublishable12345

# Commission Settings
DEFAULT_COMMISSION_PERCENTAGE=10
